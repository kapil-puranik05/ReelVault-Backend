# Gemini API — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini models
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Model provider — "openrouter" sends vision/audio/summary calls through OpenRouter
# (for models the Gemini key can't reach). Embeddings always stay on the Gemini API.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=

# Embedding dimensionality (must match pgvector dim in supabase/schema.sql)
EMBEDDING_OUTPUT_DIM=768

# Frame sampling
SAMPLE_FPS=1.0
MAX_FRAMES=120
FRAME_WIDTH=768
FRAMES_PER_VISION_BATCH=20

# Pipeline behavior — default should be dry-run to avoid paid Gemini calls
DRY_RUN=true

# ── HTTP API layer ───────────────────────────────────────────────────────────
# Same Supabase project the frontend and other backend already use — this one
# reuses it for BOTH auth (JWT verification) and data storage (Postgres + pgvector),
# so there's no separate database account to create.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Subscription / billing ───────────────────────────────────────────────────
# Run supabase/subscriptions.sql once in the Supabase SQL editor.
TRIAL_DURATION_DAYS=7
# Price in major units (rupees). ₹1/month is temporary — change it here only.
PAID_PLAN_PRICE=1
PAID_PLAN_CURRENCY=INR
# Razorpay needs a finite number of billing cycles per subscription.
PAID_PLAN_TOTAL_COUNT=120
# Per-reel pack: price is set, the reel limit is undecided — leave empty (not enforced).
REEL_SAVE_PRICE=40
# REEL_SAVE_LIMIT=

# Razorpay (dashboard -> Account & Settings -> API Keys). The secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (dashboard -> Webhooks).
# Test and live are separate Razorpay worlds: switching to rzp_live_ keys needs a NEW webhook created while the
# dashboard is in Live mode (its own secret), pointing at <backend>/api/subscription/webhook with these events:
#   subscription.* (authenticated, activated, charged, completed, updated, pending, halted, cancelled, paused,
#   resumed), payment.captured, payment.failed, refund.processed.
# Payments are recorded in the backend-only `payments` table (run supabase/payments.sql first).
RAZORPAY_WEBHOOK_SECRET=
